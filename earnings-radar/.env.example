# ── Database ──────────────────────────────────────────────────────────────────
# Postgres in production; falls back to local SQLite if unset.
# Uncomment for Postgres; leave commented to use local SQLite (no setup needed).
# DATABASE_URL=postgresql+psycopg2://radar:radar@localhost:5432/earnings_radar

# ── Anthropic (LLM analysis engine) ───────────────────────────────────────────
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-opus-5

# ── Market data / calendar providers (all optional — adapters skip if unset) ──
FINNHUB_API_KEY=
FMP_API_KEY=
# Polygon.io — real-time and extended-hours prices, minute bars, reference data
# and short interest. This is what Catalyst Sentinel's Move Amplification and
# Reaction Room run on; without it they have no price inputs and cap themselves.
# Free float is the one input Polygon does not publish — it comes from FMP.
POLYGON_API_KEY=
# Polygon is now Massive; api.polygon.io still serves the same API and keys.
POLYGON_BASE_URL=https://api.polygon.io
# How far behind live your plan's prices are, in seconds.
#   900 = Polygon Stocks Starter ($29/mo, 15-minute delayed)  <- current
#     0 = Polygon Stocks Advanced ($199/mo, real-time)
# Changing this ONE number is the entire Starter -> Advanced upgrade. It is not
# cosmetic: the system uses it to tell "the stock has not moved" apart from
# "we cannot see the move yet", which are opposite conclusions.
MARKET_DATA_DELAY_SECONDS=900

# ── SEC EDGAR etiquette (REQUIRED for detection; use your real contact) ───────
SEC_USER_AGENT="Earnings Radar (your-email@example.com)"

# ── Push notifications ────────────────────────────────────────────────────────
# ntfy: install the ntfy iOS app, subscribe to a long random topic name.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Pushover (optional second channel): https://pushover.net
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# ── Catalyst Sentinel (non-earnings catalysts) ────────────────────────────────
CATALYST_SENTINEL_ENABLED=true
CATALYST_PUSH_SCORE=9.0
CATALYST_EXTREME_SCORE=9.5
CATALYST_MIN_CONFIDENCE=7.0
MIN_ENTITY_CONFIDENCE=0.7
MIN_SOURCE_QUALITY=0.5
CATALYST_MIN_MARKET_CAP=50000000
CATALYST_MIN_SHARE_PRICE=1.0
CATALYST_MIN_AVG_DOLLAR_VOLUME=500000
ALLOW_OTC=false
NEWS_MAX_AGE_SECONDS=3600
PRICE_MAX_AGE_SECONDS=120
REACTION_ROOM_MIN_ALERT=3.0
MAX_NEGATIVE_OFFSET_FOR_ALERT=6.0
CATALYST_FAST_MODEL=claude-haiku-4-5
# Continuous detection sweep (SEC latest-filings feed + any news provider)
CATALYST_POLL_SECONDS=30
CATALYST_FILING_LOOKBACK_MINUTES=90
CATALYST_MAX_UNIVERSE=400
# Comparator used to strip the market move out of an abnormal move
BENCHMARK_TICKER=SPY
CATALYST_RUNUP_LOOKBACK_DAYS=10
CATALYST_ATR_DAYS=14

# Outcome capture — records what actually happened after each scored catalyst.
# Without it, calibration has no sample and the analogue engine stays a guess.
OUTCOME_CAPTURE_ENABLED=true
OUTCOME_CAPTURE_INTERVAL_SECONDS=300
OUTCOME_CAPTURE_WINDOW_DAYS=5

# Re-scoring. On a delayed feed a catalyst is scored before its move is visible;
# this pass revisits it once the data arrives. Costs no Claude usage — the
# original analysis is reused and only the price half is recomputed.
RESCORE_ENABLED=true
RESCORE_INTERVAL_SECONDS=120
RESCORE_WINDOW_HOURS=6
# Licensed real-time newswire (interface ready; adapter not yet implemented)
BENZINGA_API_KEY=

# ── Behaviour ─────────────────────────────────────────────────────────────────
LOCAL_TZ=Europe/London
DISCOVERY_TIMES=05:00,09:00,13:00,18:00,20:00
MIN_NOTIFICATION_SCORE=0.0
HIGH_SCORE_ALERT=9.0
MIN_CONFIDENCE_FOR_NOTIFICATION=75
MONITOR_BURST_INTERVAL_SECONDS=20
DELAYED_GRACE_MINUTES=240
SCORING_MODEL_VERSION=1.0.0
